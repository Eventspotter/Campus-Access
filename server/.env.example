PORT=4000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/campus_access
# Optional: set these separately to URL-encode Atlas credentials automatically.
# MONGODB_USER=
# MONGODB_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=replace-with-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
